# ============================================================================
#  MinerU 便携版 —— 分发用 .gitignore
#
#  原则：仓库里只保留「不可再生、由人编写」的文件；
#        凡是能从官网/镜像重新拉的、运行时自动生成的，一律忽略。
#
#  结果：仓库 ≈ 3.6 MB（含 whl）/ 87 KB（不含 whl），
#        而完整可用的包 ≈ 2.6 GB —— 剩下的由首次启动自动补齐。
# ============================================================================

# --- 便携 Python 运行时（步骤 0：scripts/bootstrap_python.ps1 自动下载）-----
/runtime/

# --- 模型权重（步骤 2：app/bootstrap.py 从 ModelScope 自动下载）-------------
/data/models/
/data/hf-cache/
/data/ms-cache/

# --- 运行期产物：日志 / 临时文件 / WebUI 缓存 / 隔离的 AppData ---------------
#     这些目录由 app/env_setup.py 的 ensure_dirs() 在启动时自动重建，
#     所以完全可以不入库。
/data/logs/
/data/temp/
/data/gradio/
/data/appdata/
/data/localappdata/
/data/LocalLow/
/data/models/.locks/
/output/
/_tmp/
/_cache/

# --- 文档库（doclib）运行期状态 --------------------------------------------
#     SQLite 文档库 + WAL + 端点信息（含 PID / server_id），全属本机运行时产物，
#     换台机器就没有意义，且可能泄露本机路径，一律不入库。
/data/doclib/
/data/doclib.db
/data/doclib.db-wal
/data/doclib.db-shm
/data/doclib.endpoint.json

# --- 可再生的编译产物（解释器用到时会自己重建）------------------------------
#     打包时已从这里清出 230 MB（11714 个文件）。
__pycache__/
*.py[cod]
*.pdb
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- 编辑器 / 系统杂物 ------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
*.log
~$*

# --- 本机临时文件 -----------------------------------------------------------
/tmp/
/temp/
